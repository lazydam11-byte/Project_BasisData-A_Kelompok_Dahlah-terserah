@startuml Activity_Pembelian_Pembayaran
title Activity Diagram: Pembelian dan Pembayaran
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ActivityBackgroundColor #EAF2FB
skinparam ActivityBorderColor #1F3A5F
skinparam ArrowColor #1F3A5F
skinparam wrapWidth 190

|Pelanggan|
start
:Membuka katalog dan memilih produk;
:Menambahkan produk ke keranjang;
:Login atau daftar akun;
:Checkout dan memilih metode pembayaran;
|Sistem|
:Mengunci baris produk;
if (Stok semua produk cukup?) then (ya)
  :Mengurangi stok;
  :Membuat transaksi (Belum Dibayar)\ndan detail penjualan;
else (tidak)
  :Menampilkan pesan stok tidak cukup;
  stop
endif
|Pelanggan|
if (Metode pembayaran?) then (Transfer Bank / QRIS)
  :Membayar dan mengunggah bukti;
else (Bayar di Toko)
  :Membayar langsung di toko;
endif
|Kasir / Manajer|
:Memeriksa pembayaran;
if (Pembayaran valid?) then (ya)
  |Sistem|
  :Status menjadi Lunas;
  :Menerbitkan garansi untuk\nproduk bergaransi;
else (tidak atau dibatalkan)
  |Sistem|
  :Status menjadi Dibatalkan,\nstok dikembalikan;
endif
stop
@enduml
