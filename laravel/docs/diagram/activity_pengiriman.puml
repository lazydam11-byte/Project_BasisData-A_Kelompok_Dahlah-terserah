@startuml Activity_Pengiriman
title Activity Diagram: Pengiriman Pesanan Online sampai Diterima Pembeli
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ActivityBackgroundColor #EAF2FB
skinparam ActivityBorderColor #1F3A5F
skinparam ArrowColor #1F3A5F
skinparam wrapWidth 190

|Pelanggan|
start
:Checkout: pilih Kirim ke alamat,\nisi penerima dan alamat, pilih kurir;
|Sistem|
:Menghitung ongkir dari tarif kurir;
:Membuat transaksi dan data pengiriman\n(status Menunggu Pembayaran);
|Pelanggan|
:Membayar (Transfer Bank / QRIS)\ndan mengunggah bukti;
|Kasir / Manajer|
:Memeriksa pembayaran;
if (Pembayaran valid?) then (ya)
  |Sistem|
  :Status pembayaran Lunas,\ngaransi terbit,\nstatus pengiriman Dikemas;
  |Kasir / Manajer|
  :Menyerahkan paket ke kurir\ndan mengisi nomor resi;
  |Sistem|
  :Status pengiriman Dikirim;
  |Pelanggan|
  :Melacak status dan nomor resi;
  :Menerima paket dan menekan\nPesanan sudah saya terima;
  |Sistem|
  :Status pengiriman Diterima;
else (tidak atau dibatalkan)
  |Sistem|
  :Pesanan Dibatalkan,\nstok dikembalikan,\nstatus pengiriman Dibatalkan;
endif
stop
@enduml
