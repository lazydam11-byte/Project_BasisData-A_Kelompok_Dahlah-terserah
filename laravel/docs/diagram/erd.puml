@startuml ERD_Gadgetkuori
title ERD Gadgetkuori.com
hide circle
skinparam dpi 170
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam linetype ortho
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #1F3A5F
  HeaderBackgroundColor #DCE8F7
}
skinparam ArrowColor #1F3A5F

entity "kategori" as kategori {
  * id_kategori : BIGINT <<PK>>
  --
  * nama_kategori : VARCHAR(100)
}

entity "merek" as merek {
  * id_merek : BIGINT <<PK>>
  --
  * nama_merek : VARCHAR(100)
  * negara_asal : VARCHAR(100)
}

entity "produk" as produk {
  * id_produk : BIGINT <<PK>>
  --
  * id_kategori : BIGINT <<FK>>
  * id_merek : BIGINT <<FK>>
  * nama_produk : VARCHAR(150)
  * harga : BIGINT
  * stok : INT
  * lama_garansi : SMALLINT (bulan)
  * tanggal_masuk : DATE
  foto_produk : VARCHAR(255)
}

entity "pelanggan" as pelanggan {
  * id_pelanggan : BIGINT <<PK>>
  --
  * nama : VARCHAR(100)
  alamat : TEXT
  no_telepon : VARCHAR(20)
  email : VARCHAR(100) <<UQ>>
  username : VARCHAR(50) <<UQ>>
  password : VARCHAR(255)
  remember_token : VARCHAR(100)
}

entity "pegawai" as pegawai {
  * id_pegawai : BIGINT <<PK>>
  --
  * nama : VARCHAR(100)
  * jabatan : VARCHAR(30)
  * username : VARCHAR(50) <<UQ>>
  * password : VARCHAR(255)
  remember_token : VARCHAR(100)
}

entity "transaksi_penjualan" as transaksi {
  * id_transaksi : BIGINT <<PK>>
  --
  * id_pelanggan : BIGINT <<FK>>
  id_pegawai : BIGINT <<FK>>
  * tanggal : DATETIME
  * metode_pembayaran : VARCHAR(30)
  * status_pembayaran : VARCHAR(30)
  * total_bayar : BIGINT
  bukti_pembayaran : VARCHAR(255)
}

entity "detail_penjualan" as detail {
  * id_detail : BIGINT <<PK>>
  --
  * id_transaksi : BIGINT <<FK>>
  * id_produk : BIGINT <<FK>>
  * jumlah : INT
  * harga_satuan : BIGINT
  * subtotal : BIGINT
}

entity "pengiriman" as pengiriman {
  * id_pengiriman : BIGINT <<PK>>
  --
  * id_transaksi : BIGINT <<FK, UQ>>
  * nama_penerima : VARCHAR(100)
  * telepon_penerima : VARCHAR(20)
  * alamat_tujuan : TEXT
  * kurir : VARCHAR(30)
  * ongkir : BIGINT
  no_resi : VARCHAR(40)
  * status_pengiriman : VARCHAR(25)
  tanggal_dikirim : DATETIME
  tanggal_diterima : DATETIME
}

entity "garansi" as garansi {
  * id_garansi : BIGINT <<PK>>
  --
  * id_detail : BIGINT <<FK, UQ>>
  * nomor_garansi : VARCHAR(30) <<UQ>>
  * tanggal_mulai : DATE
  * lama_garansi : SMALLINT (bulan)
  * tanggal_berakhir : DATE
  ketentuan_garansi : TEXT
}

entity "klaim_garansi" as klaim {
  * id_klaim : BIGINT <<PK>>
  --
  * id_garansi : BIGINT <<FK>>
  id_pegawai : BIGINT <<FK>>
  * tanggal_klaim : DATE
  tanggal_selesai : DATE
  * keluhan : TEXT
  * kondisi_barang : TEXT
  * status_klaim : VARCHAR(20)
  keterangan : TEXT
}

kategori ||--o{ produk : "memiliki"
merek ||--o{ produk : "memproduksi"
pelanggan ||--o{ transaksi : "melakukan"
pegawai |o--o{ transaksi : "memproses"
transaksi ||--|{ detail : "terdiri dari"
transaksi ||--o| pengiriman : "dikirim melalui"
produk ||--o{ detail : "dibeli pada"
detail ||--o| garansi : "menerbitkan"
garansi ||--o{ klaim : "diklaim melalui"
pegawai |o--o{ klaim : "menangani"
@enduml
