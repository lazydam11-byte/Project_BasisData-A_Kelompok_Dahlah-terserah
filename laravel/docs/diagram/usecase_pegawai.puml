@startuml UseCase_Pegawai
title Use Case Diagram Sisi Pegawai - Gadgetkuori.com
left to right direction
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #1F3A5F
}
skinparam ArrowColor #1F3A5F

actor "Manajer" as Man
actor "Kasir" as Kas
actor "Teknisi" as Tek
actor "Gudang" as Gud
actor "Pegawai" as Peg
Man --|> Peg
Kas --|> Peg
Tek --|> Peg
Gud --|> Peg

rectangle "Gadgetkuori.com" {
  usecase "Login pegawai" as P1
  usecase "Melihat dashboard stok" as P2
  usecase "Melihat produk,\nkategori, merek" as P3
  usecase "Mengelola produk,\nkategori, merek" as P4
  usecase "Mengelola pegawai" as P5
  usecase "Mengelola pelanggan\n(tanpa hapus)" as P6
  usecase "Konfirmasi lunas /\nbatalkan transaksi" as P7
  usecase "Menerbitkan garansi\notomatis" as P10
  usecase "Melihat laporan\npenjualan & CSV" as P8
  usecase "Memproses klaim\ngaransi" as P9
  usecase "Menyerahkan paket ke\nkurir (input no. resi)" as P11
}

Peg --> P1
Peg --> P2
Peg --> P3
Gud --> P4
Man --> P4
Man --> P5
Man --> P8
Man --> P6
Kas --> P6
Man --> P7
Kas --> P7
Man --> P9
Man --> P11
Kas --> P11
Tek --> P9
P7 ..> P10 : <<include>>
@enduml
